# BLE is the only ESP32 transport. No relay token, IP address or HTTP port is required.
MUXIVA_BLE_DEVICE_NAME=Muxiva-RLCD
# MUXIVA_BLE_SELECTION_PATH=runtime/ble-device.json
MUXIVA_STATUS_INTERVAL_SECONDS=3

# Continue the newest Codex task, or replace `latest` with a concrete task UUID.
MUXIVA_CODEX_TARGET=latest
# Windows: C:\path\to\your\workspace
# macOS: /Users/you/code/your-workspace
MUXIVA_CODEX_CWD=C:\path\to\your\workspace
MUXIVA_CODEX_SANDBOX=workspace-write
MUXIVA_CODEX_APPROVAL_POLICY=never
# Usually auto-discovered. Set only when Codex CLI is not on PATH.
# MUXIVA_CODEX_BIN=/Users/you/.local/bin/codex

# Local ASR (recommended and used by default).
MUXIVA_ASR_PROVIDER=sensevoice
MUXIVA_SENSEVOICE_MODEL_DIR=runtime/models/sherpa-onnx-sense-voice-zh-en-ja-ko-yue-int8-2024-07-17
MUXIVA_SENSEVOICE_THREADS=2

# Optional S1-mini text cleanup. The relay works when this service is absent.
MUXIVA_S1_BASE_URL=http://127.0.0.1:8091/v1
MUXIVA_S1_MODEL=superwhisper/s1-mini
MUXIVA_S1_TIMEOUT_SECONDS=20

# Optional cloud ASR fallback. Leave empty when using local SenseVoice.
MUXIVA_ASR_MODEL=qwen3-asr-flash-realtime
MUXIVA_ASR_TIMEOUT_SECONDS=25
MUXIVA_ASR_REGION=cn-beijing
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_API_KEY=
