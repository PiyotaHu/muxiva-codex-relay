# HTTP server exposed only to the local LAN.
MUXIVA_RELAY_HOST=0.0.0.0
MUXIVA_RELAY_PORT=8765
MUXIVA_RELAY_TOKEN=replace-with-the-same-token-as-esp32-HUB_AUTH_TOKEN

# Existing ESP32 Hub endpoint. An IP is more reliable than mDNS on Windows.
MUXIVA_ESP_HUB_URL=http://YOUR_ESP32_IP:8080/hub
MUXIVA_ESP_HUB_TOKEN=replace-with-the-same-token-as-esp32-HUB_AUTH_TOKEN
MUXIVA_STATUS_INTERVAL_SECONDS=3

# Optional BLE failover. The relay acts as the BLE central and reconnects automatically.
MUXIVA_BLE_ENABLED=0
MUXIVA_BLE_DEVICE_NAME=Muxiva-RLCD

# Optional Raspberry Pi LAN bridge. The SSH key stays under ignored runtime/.
MUXIVA_PI_SSH_TARGET=pi@raspberrypi.local

# Single-session default: resolve the newest thread once and keep appending turns.
# For an installation that must survive restarts without changing sessions, use
# a concrete thread UUID. `new` is opt-in legacy multi-session behavior.
MUXIVA_CODEX_TARGET=latest
# Windows example: C:\path\to\your\workspace
# macOS example: /Users/you/code/your-workspace
MUXIVA_CODEX_CWD=C:\path\to\your\workspace
MUXIVA_CODEX_SANDBOX=workspace-write
MUXIVA_CODEX_APPROVAL_POLICY=never
# Optional override. By default the relay discovers Codex Desktop's bundled CLI.
# MUXIVA_CODEX_BIN=C:\Users\you\AppData\Local\OpenAI\Codex\bin\...\codex.exe
# macOS normally discovers `codex` from PATH. launchd also checks common
# Homebrew, official-installer, npm, Volta and nvm locations.
# MUXIVA_CODEX_BIN=/Users/you/.local/bin/codex

# S1-mini is an English-only ASR text normalizer, not an ASR model.
# Start llama-server with superwhisper/s1-mini-GGUF, then enable this endpoint.
MUXIVA_S1_BASE_URL=http://127.0.0.1:8091/v1
MUXIVA_S1_MODEL=superwhisper/s1-mini
MUXIVA_ASR_MODEL=qwen3-asr-flash-realtime
MUXIVA_ASR_TIMEOUT_SECONDS=25
MUXIVA_ASR_REGION=cn-beijing
MUXIVA_ASR_PROVIDER=sensevoice
MUXIVA_SENSEVOICE_MODEL_DIR=runtime/models/sherpa-onnx-sense-voice-zh-en-ja-ko-yue-int8-2024-07-17
MUXIVA_SENSEVOICE_THREADS=2
DASHSCOPE_WORKSPACE_ID=replace-with-workspace-id
DASHSCOPE_API_KEY=replace-with-api-key
MUXIVA_S1_TIMEOUT_SECONDS=20
